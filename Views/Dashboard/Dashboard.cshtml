@model List<Database_lab_project.Models.Item>

@{
    ViewData["Title"] = "Dashboard";
}
@if (TempData["Message"] != null)
{
    <div class="popup @TempData["Type"]">
        @TempData["Message"]
    </div>
}

<div class="dash-page">
    <nav class="dash-nav">
        <div class="logo"> <a class="HeaderLink" href="/Dashboard/Dashboard">Uni<span>Trace</span></a></div>

        <div class="nav-actions">
            <button class="outline-red">
                <a asp-controller="Item" asp-action="SearchPage" class="HeaderLink">
                    + I Lost Something
                </a>
            </button>
            <button class="green-btn" onclick="openModal('foundModal')">+ Report Found</button>
        </div>
    </nav>
    <div class="logout-div">
           <button class="red-btn" onclick="location.href='/Auth/Logout'">Logout</button>
    </div>

    <section class="hero">
        <p class="badge">LOST & FOUND PLATFORM</p>
        <h1>Reuniting people<br />with their <span>belongings</span></h1>
        <p class="hero-text">Browse items reported lost or found in your area. Submit a report and help someone recover what matters.</p>

        <div class="hero-buttons">
            <button class="outline-red">
                <a asp-controller="Item" asp-action="SearchPage" class="HeaderLink ">
                    + I Lost Something
                </a>
            </button>
            <button class="green-btn" onclick="openModal('foundModal')">+ I Found Something</button>
        </div>
    </section>

    <div class="dashboard-tabs">
        <button onclick="showSection('feedSection')">Feed</button>
        <button onclick="showSection('claimSection')">Claim Requests</button>
    </div>

    <section id="feedSection" class="items-grid">
        @foreach (var item in Model)
        {
            <div class="item-card">
                <div style="width: 70%">
                    <h3>@item.Title</h3>
                    <p>@item.Description</p>
                    <p><b>Category:</b> @item.Category</p>
                    <p><b>Location:</b> @item.LocationFound</p>
                    <p><b>Lost Date:</b> @item.LostDate.ToShortDateString()</p>
                </div>
                <div>
                    @if (item.userId != ViewBag.userId)
                    {
                        <button onclick="showItemModal(@item.itemId)" class="outline-red">Claim Item</button>
                    }
                    else
                    {
                        <span class="badge" style="color: gray; font-weight: bold;">Your Posted Item</span>
                    }
                </div>
            </div>
        }
    </section>


    <section id="claimSection" class="claim-items" style="display:none;">
        <div class="item-card">
            <h3>Claim Requests</h3>
        </div>
        <div>
            <div>
                @if (ViewBag.Claims != null)
                {
                    foreach (var claim in ViewBag.Claims)
                    {
                        
                        
                        <div class="item-card">
                            <div style="width: 70%">
                                <h3>@claim.Title</h3>
                                <p>Requested By: @claim.RequestingUser</p>
                                <p>Requested By: @claim.LocationFound</p>
                            </div>
                            <div>
                                <form method="post" action="/Claim/ApproveRequest" style="display:inline;">
                                    <input type="hidden" name="itemId" value="@claim.ItemId" />
                                    <button type="submit" class="outline-red">✔️ Approve</button>
                                </form>

                                <form method="post" action="/Claim/RejectRequest" style="display:inline;">
                                    <input type="hidden" name="itemId" value="@claim.ItemId" />
                                    <button type="submit" class="green-btn">❌ Reject</button>
                                </form>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p>No claim requests yet.</p>
                }
            </div>
        </div>
        
    </section>

</div>

<!-- FOUND MODAL -->
<div class="modal" id="foundModal">
    <div class="modal-card">
        <button class="close-btn" onclick="closeModal('foundModal')">×</button>
        <div class="modal-title found-dot"><span></span><h2>Report Found Item</h2></div>

        <form method="post" action="/Item/ReportFound">
            <h4>ITEM DETAILS</h4>
            <label>Item Title *</label>
            <input name="itemTitle" placeholder="e.g. Blue Nokia Phone" />

            <div class="row">
                <div>
                    <label>Category *</label>
                    <select name="category" required>
                        <option value="">Select category</option>
                        <option>University ID</option>
                        <option>CNIC</option>
                        <option>Mobile</option>
                        <option>Wallet</option>
                        <option>Key chain</option>
                        <option>Bag</option>
                        <option>Water Bottle</option>
                        <option>Others</option>
                    </select>
                </div>
                <div>
                    <label>Date Found *</label>
                    <input name="lostDate" type="date" />
                </div>
            </div>

            <label>Location Found *</label>
            <input name="lostLocation" placeholder="e.g. Block H, CS Depart" />

            <label>Description</label>
            <textarea name="description" placeholder="Describe the item so the owner can identify it..."></textarea>

            <button class="submit-found">Report Found Item</button>
        </form>
    </div>
</div>

<section id="claimForm">
    <div class="modal-card">
        <button class="close-btn" onclick="closeModalClaimForm()">×</button>
        <div class="modal-title found-dot"><span></span><h2>Report Found Item</h2></div>

        <form method="post" action="/Claim/ClaimForm">
            <h4>CLAIM ITEM</h4>
            <input type="hidden" id="claimItemId" name="itemId" />

            <label>Your Name *</label>
            <input name="name" placeholder="e.g. Ali" />

            <label>Hiddeen Details of Item *</label>
            <input name="hiddenDetails" placeholder="Describe the item hidden details so the owner can identify it..." />

            <label>Lost Location *</label>
            <input type="text" name="lostLocation" placeholder="Lost Location e.g. Admission Cell" />

            <button class="submit-claim-request">Claim Item</button>
        </form>
    </div>
</section>

<script>
        let claimForm = document.getElementById("claimForm");
    let itemId = document.getElementById("claimItemId");
    function openModal(id) {
        document.getElementById(id).style.display = "grid";
    }

    function closeModal(id) {
        document.getElementById(id).style.display = "none";
    }

      function showItemModal(id) {
           console.log(id)
           itemId.value = id;
           claimForm.style.display = "block";
    }

    function showSection(id) {
        document.getElementById("feedSection").style.display = "none";
        document.getElementById("claimSection").style.display = "none";

        document.getElementById(id).style.display = "grid";
    }

        function closeModalClaimForm() {
        claimForm.style.display = "none";
    }

    function approveRequest(id){
        console.log(id)
    }
</script>